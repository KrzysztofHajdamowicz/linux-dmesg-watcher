# Copy to /etc/nas-dmesg-watcher.env and fill in. Then:
#   chmod 600 /etc/nas-dmesg-watcher.env
MQTT_BROKER=tcp://192.168.1.31:1883
MQTT_USERNAME=CHANGE_ME
MQTT_PASSWORD=CHANGE_ME
TOPIC_PREFIX=nas/dmesg-watch
# Suppression window; matches within it are aggregated into one summary alert.
COOLDOWN=5m
# Optional: file with one regex per line, replacing built-in patterns.
#PATTERN_FILE=/etc/nas-dmesg-watcher.patterns
